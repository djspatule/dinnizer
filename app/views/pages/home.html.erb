<div class="banner" style="background-image: linear-gradient(-225deg, rgba(0,101,168,0.78) 0%, rgba(0,36,61,0.78) 50%), url('<%= image_path "background.jpg" %>');">
  <div class="banner-content">
    <h1>Dinnizer</h1>
    <p class="banner-tagline">Remember what you cooked, who came, and what they liked.</p>
    <p class="banner-description">Dinnizer helps you keep track of dinners, guests and recipes so planning the next invitation is easier.</p>
    <%= link_to "Start planning dinners", new_user_registration_path, class: "btn btn-primary btn-lg" %>
    <br>
    <%= link_to "Log in", new_user_session_path, class: "banner-login" %>
  </div>
</div>
