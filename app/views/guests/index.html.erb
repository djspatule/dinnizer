<div class="container">
  <div class="row  col-xs-12 col-md-9 col-md-offset-1">
    <h1> All guests </h1>
    <%= link_to "New guest", new_guest_path, class:"btn btn-primary" %>

    <% if @guests.empty? %>
      <p>You have no guest yet. <%= link_to "Add someone", new_guest_path %> you often invite.</p>
    <% end %>
    
    <% @guests.each do |guest| %>
      <div class="product">
        <!--<div class='product-upvote'>
          <div class="product-arrow"></div>
          <div class='product-count'>0</div>
        </div>-->
        <% if guest.guest_photo? %>
          <%= cl_image_tag guest.guest_photo.path, class: "product-image hidden-xs" %>
        <% else %>
          <%= image_tag "logo.png", class: "product-image hidden-xs" %>
        <% end %>
        <div class='product-body'>
          <h3><%= link_to guest.first_name + " " + guest.last_name, guest_path(guest) %></h3>
        </div>
        <ul class="list-inline hidden-sm hidden-xs">
          <li>
            <%= link_to guest_path(guest) do %>
              <i class="fa fa-eye"></i>
            <% end %>
          </li>
          <li>
            <%= link_to edit_guest_path(guest) do %>
              <i class="fa fa-pencil"></i>
            <% end %>
          </li>
          <li>
            <%= link_to guest_path(guest), method: :delete, data: { confirm: "Are you sure?" } do %>
              <i class="fa fa-trash"></i>
            <% end %>
          </li>
        </ul>
      </div>
    <% end %>
  </div>
</div>
